NODE_ENV=production
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
AGENT_API_TOKEN=
# Optional shared model override. Leave blank to use the stage defaults below.
DISCOVERY_MODEL=
# Optional per-stage overrides
DISCOVERY_RESEARCH_MODEL=gpt-5.6-luna
DISCOVERY_FORMAT_MODEL=gpt-5.6-luna
# Optional; defaults to 20 public searches per hour
PUBLIC_SEARCHES_PER_HOUR=20
