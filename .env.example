NODE_ENV=production
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
AGENT_API_TOKEN=

# Optional shared model override. Leave blank to use stage defaults.
DISCOVERY_MODEL=

# Optional per-stage model overrides.
DISCOVERY_RESEARCH_MODEL=gpt-5.6-luna
DISCOVERY_FORMAT_MODEL=gpt-5.6-luna

# Optional Agent 2 overrides; falls back to discovery stage models.
ENRICHMENT_RESEARCH_MODEL=gpt-5.6-luna
ENRICHMENT_FORMAT_MODEL=gpt-5.6-luna

# Website Intelligence runs automatically during Agent 2 enrichment.
WEBSITE_AUDIT_MAX_PAGES=15
WEBSITE_AUDIT_CACHE_DAYS=30
WEBSITE_AUDIT_FETCH_TIMEOUT_MS=8000
# Optional. Enables homepage PageSpeed/Lighthouse mobile + desktop metrics.
GOOGLE_PAGESPEED_API_KEY=

# Optional Agent 4 overrides; falls back to enrichment/discovery models.
CONTACT_RESEARCH_MODEL=gpt-5.6-luna
CONTACT_FORMAT_MODEL=gpt-5.6-luna

# Optional Agent 5 model override; falls back to contact/enrichment/discovery models.
OUTREACH_MODEL=gpt-5.6-luna

# Minimum Agent 3 score required before Agent 4 can run.
CONTACT_RESOLUTION_MIN_SCORE=65

# Optional; defaults to 20 public searches per hour.
PUBLIC_SEARCHES_PER_HOUR=20

# Automated qualification pipeline. Hard-capped by the app at 100.
QUALIFICATION_JOB_MAX_RECORDS=100
QUALIFICATION_CONCURRENCY=2
QUALIFICATION_MAX_ATTEMPTS=2
PUBLIC_QUALIFICATION_JOBS_PER_HOUR=3
